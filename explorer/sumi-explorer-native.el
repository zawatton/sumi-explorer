 (defun sumi_explorer_same (a b)
   (if (and (= (= a 0) 0) (= (= b 0) 0)) (= (extern-call strcmp a b) 0) 0))

 (defun sumi_explorer_free_path (path) (seq (extern-call g_free path) 0))

 ;; GTK_ACCESSIBLE_PROPERTY_LABEL is 4. Names are independent of icon themes.
 (defun sumi_explorer_ui_name (widget label)
   (seq (extern-call gtk_accessible_update_property widget 4 label -1)
        (extern-call gtk_widget_set_tooltip_text widget label) widget))

 (defun sumi_explorer_ui_icon (button label icon text)
   (let ((box (extern-call gtk_box_new 0 6)))
     (seq
      (extern-call gtk_box_append box (extern-call gtk_image_new_from_icon_name icon))
      (if text (extern-call gtk_box_append box (extern-call gtk_label_new label)))
      (extern-call gtk_button_set_child button box)
      (extern-call gtk_widget_add_css_class button (data-addr flat_class))
      (sumi_explorer_ui_name button label))))

 (defun sumi_explorer_ui_action (bar label icon action ctx text)
   (let ((button (extern-call gtk_button_new)))
     (seq
      (sumi_explorer_ui_icon button label icon text)
      (extern-call g_object_set_data button (data-addr operation_key) action)
      (extern-call g_signal_connect_data button (data-addr clicked) (addr-of sumi_explorer_context_action) ctx 0 0)
      (if (and (>= action 5) (<= action 10)) (ptr-write-u64 (ptr-read-u64 ctx 728) (+ 80 (* (- action 5) 8)) button))
      (if (= action 13) (ptr-write-u64 (ptr-read-u64 ctx 728) 128 button))
      (if (= action 16) (ptr-write-u64 (ptr-read-u64 ctx 728) 136 button))
      (if (= action 17) (ptr-write-u64 (ptr-read-u64 ctx 728) 144 button))
      (extern-call gtk_box_append bar button) button)))

 (defun sumi_explorer_ui_workspace (bar label icon action ctx text)
   (let ((button (extern-call gtk_button_new)))
