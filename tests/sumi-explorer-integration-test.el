;;; sumi-explorer-integration-test.el --- Real native host checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'sumi-explorer)

(ert-deftest sumi-explorer-native-emacs-workflow ()
  "Use the real native GUI through the same command channel as Emacs."
  (let* ((root (make-temp-file "sumi-native-integration-" t))
         (directory (expand-file-name "日本語 folder" root))
         (child (expand-file-name "child" directory))
         (file (expand-file-name "日本語 with spaces.txt" directory))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN")
                     sumi-explorer--default-executable))
         (sumi-explorer--session-directory nil)
         (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil)
         (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (make-directory child t)
          (with-temp-file file (insert "fixture\n"))
          (sumi-explorer-start directory binary)
          (should (process-live-p sumi-explorer--process))
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) directory))
          (sumi-explorer-select file)
          (should (equal (sumi-explorer-selected-files) (list file)))
          (sumi-explorer-properties)
          (sumi-explorer-open-directory child)
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) child))
          (should-not (sumi-explorer-selected-files))
          (should-error (sumi-explorer-open-directory (expand-file-name "missing" root)))
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) child))
          (sumi-explorer-refresh)
          (sumi-explorer-open-directory directory)
          (sumi-explorer-select file)
          (should (equal (sumi-explorer-selected-files) (list file)))
          ;; Native keyboard activation changes the same state Emacs reads.
          (sumi-explorer-select child)
          (let ((window (string-trim
                         (with-temp-buffer
                           (should (= 0 (call-process "xdotool" nil t nil "search" "--sync"
                                                      "--name" "^Sumi Explorer$")))
                           (buffer-string)))))
            (setq window (car (last (split-string window "\n" t))))
            (should (= 0 (call-process "xdotool" nil nil nil "windowfocus" "--sync" window)))
            (should (= 0 (call-process "xdotool" nil nil nil "key" "Return"))))
          (let ((deadline (+ (float-time) 5)))
            (while (and (< (float-time) deadline)
                        (not (equal (cdr (assoc "directory" (sumi-explorer-state))) child)))
              (accept-process-output sumi-explorer--process 0.02)))
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) child))
          (should-not (sumi-explorer-selected-files)))
      (sumi-explorer-stop)
      (delete-directory root t))))

(defun sumi-explorer-integration--bytes (file)
  "Return FILE's literal bytes for preservation assertions."
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally file)
    (buffer-string)))

(ert-deftest sumi-explorer-native-emacs-mutation-workflow ()
  "Exercise real native mutations using only disposable, isolated fixtures."
  (let* ((root (make-temp-file "sumi-native-mutations-" t))
         (source (expand-file-name "日本語 source" root))
         (nested (expand-file-name "nested" source))
         (payload (expand-file-name "日本語 \\ line\n.txt" nested))
         (link (expand-file-name "symlink" source))
         (copied (expand-file-name "copied tree" root))
         (moved (expand-file-name "moved tree" root))
         (renamed (expand-file-name "renamed 日本語\n tree" root))
         (collision (expand-file-name "collision" root))
         (new-directory (expand-file-name "new 日本語 directory" root))
         (xdg-data (expand-file-name "xdg-data" root))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN") sumi-explorer--default-executable))
         (process-environment (copy-sequence process-environment))
         (sumi-explorer--session-directory nil)
         (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil)
         (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0)
         (sumi-explorer--quit-requested nil)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (make-directory nested t)
          (make-directory xdg-data)
          (setenv "XDG_DATA_HOME" xdg-data)
          (with-temp-file payload (insert "original 日本語 bytes\n"))
          (with-temp-file collision (insert "collision must survive\n"))
          (make-symbolic-link (file-relative-name payload source) link)
          (sumi-explorer-start root binary)
          (sumi-explorer-copy source copied 10)
          (should (equal (sumi-explorer-integration--bytes payload)
                         (sumi-explorer-integration--bytes
                          (expand-file-name (file-relative-name payload source) copied))))
          (should (equal (file-symlink-p (expand-file-name "symlink" copied))
                         (file-symlink-p link)))
          (should-error (sumi-explorer-copy source copied 10))
          (should-error (sumi-explorer-copy payload collision 10))
          (should (equal (sumi-explorer-integration--bytes collision) "collision must survive\n"))
          (should (file-exists-p payload))
          (sumi-explorer-move copied moved 10)
          (should-not (file-exists-p copied))
          (should (file-directory-p moved))
          (sumi-explorer-rename moved (file-name-nondirectory renamed) 10)
          (should-not (file-exists-p moved))
          (should (file-directory-p renamed))
          (sumi-explorer-mkdir new-directory 10)
          (should (file-directory-p new-directory))
          (should-error (sumi-explorer-mkdir new-directory 10))
          (sumi-explorer-trash renamed 10)
          (should-not (file-exists-p renamed))
          (let ((trash-files (expand-file-name "Trash/files" xdg-data)))
            (should (file-directory-p trash-files))
            (should (cl-some (lambda (entry) (string-prefix-p "renamed 日本語" entry))
                             (directory-files trash-files nil directory-files-no-dot-files-regexp))))
          ;; Cancellation requests are cooperative; await must return the actual
          ;; operation result even when completion wins the cancellation race.
          (let ((large (expand-file-name "large source" root))
                (partial (expand-file-name "possibly partial copy" root)))
            (let ((coding-system-for-write 'no-conversion))
              (write-region (make-string (* 64 1024 1024) ?x) nil large nil 'silent))
            (let ((id (sumi-explorer-begin-operation "copy" large partial)) result)
              (should (= id (sumi-explorer-cancel)))
              (setq result (condition-case err (sumi-explorer-await 15)
                             (error (error-message-string err))))
              (should-not sumi-explorer--pending)
              (should (file-exists-p large))
              (should (= (file-attribute-size (file-attributes large)) (* 64 1024 1024)))
              (if (stringp result)
                  (should (string-match-p "[Cc]ancel\\|[Pp]artial" result))
                (should (equal (cdr (assoc "status" result)) "ok"))
                (should (= (file-attribute-size (file-attributes partial)) (* 64 1024 1024))))))
          (sumi-explorer-refresh)
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) root))
          (sumi-explorer-stop)
          (should-not sumi-explorer--session-directory))
      ;; The process owns only these fixtures; explicit force prevents an orphan
      ;; if a broken host cannot complete its test operation.
      (sumi-explorer-stop t)
      (delete-directory root t))))

(ert-deftest sumi-explorer-native-emacs-batch-workflow ()
  "Validate multiple selection and durable batch results on disposable fixtures."
  (let* ((root (make-temp-file "sumi-native-batches-" t))
         (first (expand-file-name "a 日本語;\\\n first.txt" root))
         (second (expand-file-name "b 日本語 second.txt" root))
         (paths (list first second))
         (copy-directory (expand-file-name "copies" root))
         (move-directory (expand-file-name "moves" root))
         (collision-directory (expand-file-name "collisions" root))
         (xdg-data (expand-file-name "xdg-data" root))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN") sumi-explorer--default-executable))
         (process-environment (copy-sequence process-environment))
         (sumi-explorer--session-directory nil)
         (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil)
         (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0)
         (sumi-explorer--quit-requested nil)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (dolist (directory (list copy-directory move-directory collision-directory xdg-data))
            (make-directory directory))
          (with-temp-file first (insert "first original bytes\n"))
          (with-temp-file second (insert "second original bytes\n"))
          (setenv "XDG_DATA_HOME" xdg-data)
          (sumi-explorer-start root binary)
          ;; Request order differs from display order; snapshot owns its ordering.
          (sumi-explorer-select-files (reverse paths) 5)
          (should (equal (sumi-explorer-selected-files) paths))
          (should-error (sumi-explorer-select-files
                         (list first (expand-file-name "missing" root)) 5))
          (should (equal (sumi-explorer-selected-files) paths))
          (sumi-explorer-select first)
          (should (equal (sumi-explorer-selected-files) (list first)))
          (sumi-explorer-select-files nil 5)
          (should-not (sumi-explorer-selected-files))
          (sumi-explorer-select-files paths 5)
          (let* ((result (sumi-explorer-copy-files paths copy-directory 10))
                 (id (string-to-number (cdr (assoc "request" result))))
                 (items (cdr (assoc "items" result))))
            (should (equal (mapcar (lambda (item) (cdr (assoc "path" item))) items) paths))
            (should (cl-every (lambda (item) (equal (cdr (assoc "status" item)) "ok")) items))
            (dolist (item items)
              (should (equal (sumi-explorer-integration--bytes (cdr (assoc "path" item)))
                             (sumi-explorer-integration--bytes (cdr (assoc "destination" item))))))
            ;; GUI state/selection updates must not replace the protocol result.
            (sumi-explorer-select-files nil 5)
            (sumi-explorer-open-directory copy-directory)
            (should (equal result (sumi-explorer-batch-result id)))
            (sumi-explorer-open-directory root))
          (let ((collision (expand-file-name (file-name-nondirectory first) collision-directory)))
            (with-temp-file collision (insert "preserve collision\n"))
            (let ((id (sumi-explorer-begin-batch "copy" paths collision-directory)))
              (should-error (sumi-explorer-await 10))
              (let ((items (cdr (assoc "items" (sumi-explorer-batch-result id)))))
                (should (cl-some (lambda (item) (equal (cdr (assoc "status" item)) "error")) items))
                (should-not (cl-some (lambda (item) (equal (cdr (assoc "status" item)) "ok")) items))))
            (should (equal (sumi-explorer-integration--bytes collision) "preserve collision\n"))
            (should-not (file-exists-p (expand-file-name (file-name-nondirectory second) collision-directory))))
          (let* ((copied (mapcar (lambda (path) (expand-file-name (file-name-nondirectory path) copy-directory)) paths))
                 (moved (mapcar (lambda (path) (expand-file-name (file-name-nondirectory path) move-directory)) paths)))
            (sumi-explorer-move-files copied move-directory 10)
            (should-not (cl-some #'file-exists-p copied))
            (should (cl-every #'file-exists-p moved))
            (let ((result (sumi-explorer-trash-files moved 10)))
              (should (cl-every (lambda (item) (and (equal (cdr (assoc "status" item)) "ok")
                                                  (equal (cdr (assoc "destination" item)) "")))
                                (cdr (assoc "items" result)))))
            (should-not (cl-some #'file-exists-p moved))
            (should (= 2 (length (directory-files (expand-file-name "Trash/files" xdg-data)
                                                 nil directory-files-no-dot-files-regexp)))))
          (let ((large (expand-file-name "large batch source" root))
                (cancel-directory (expand-file-name "cancel destination" root)))
            (make-directory cancel-directory)
            (let ((coding-system-for-write 'no-conversion))
              (write-region (make-string (* 32 1024 1024) ?x) nil large nil 'silent))
            (let ((id (sumi-explorer-begin-batch "copy" (list large first) cancel-directory)) response)
              (should (= id (sumi-explorer-cancel)))
              (setq response (condition-case nil (sumi-explorer-await 15) (error nil)))
              (should-not sumi-explorer--pending)
              (let ((items (cdr (assoc "items" (sumi-explorer-batch-result id)))))
                (should (= 2 (length items)))
                (if response
                    (should (cl-every (lambda (item) (equal (cdr (assoc "status" item)) "ok")) items))
                  (should (cl-some (lambda (item) (equal (cdr (assoc "status" item)) "error")) items))))
              (should (= (* 32 1024 1024) (file-attribute-size (file-attributes large))))
              (should (file-exists-p first))))
          (sumi-explorer-refresh)
          (should (cl-every #'file-exists-p paths))
          (sumi-explorer-stop)
          (should-not sumi-explorer--session-directory))
      (sumi-explorer-stop t)
      (delete-directory root t))))

(ert-deftest sumi-explorer-native-emacs-workspace-workflow ()
  "Exercise tab identities, history branches and restored selection in a real host."
  (let* ((root (make-temp-file "sumi-native-workspace-" t))
         (default-directory (expand-file-name default-directory))
         (first (expand-file-name "first 日本語" root))
         (second (expand-file-name "second" root))
         (third (expand-file-name "third" root))
         (home (expand-file-name "home" root))
         (file (expand-file-name "selected 日本語;\\\n.txt" first))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN") sumi-explorer--default-executable))
         (process-environment (copy-sequence process-environment))
         (sumi-explorer--session-directory nil)
         (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil)
         (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0)
         (sumi-explorer--quit-requested nil)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (dolist (directory (list first second third home)) (make-directory directory))
          (setenv "HOME" home)
          (setenv "XDG_CONFIG_HOME" (expand-file-name "config" root))
          (setenv "XDG_DATA_HOME" (expand-file-name "data" root))
          (setenv "XDG_CACHE_HOME" (expand-file-name "cache" root))
          (with-temp-file file (insert "workspace selection fixture\n"))
          (sumi-explorer-start first binary)
          (let* ((initial (sumi-explorer-tabs))
                 (first-id (cdr (assoc "active" initial))))
            (should (= 1 (length (cdr (assoc "tabs" initial)))))
            (should-error (sumi-explorer-back 5))
            (sumi-explorer-open-directory second)
            (sumi-explorer-back 5)
            (should (equal (cdr (assoc "directory" (sumi-explorer-state))) first))
            (sumi-explorer-forward 5)
            (should (equal (cdr (assoc "directory" (sumi-explorer-state))) second))
            (sumi-explorer-back 5)
            (sumi-explorer-open-directory third)
            (should-error (sumi-explorer-forward 5))
            (should (equal (cdr (assoc "directory" (sumi-explorer-state))) third))
            (sumi-explorer-open-directory first)
            (sumi-explorer-select file)
            (sumi-explorer-new-tab second 5)
            (let* ((workspace (sumi-explorer-tabs))
                   (second-id (cdr (assoc "active" workspace))))
              (should (= 2 (length (cdr (assoc "tabs" workspace)))))
              (should-not (equal first-id second-id))
              (should-not (sumi-explorer-selected-files))
              (sumi-explorer-activate-tab first-id 5)
              (should (equal (sumi-explorer-selected-files) (list file)))
              (sumi-explorer-activate-tab second-id 5)
              (delete-file file)
              (sumi-explorer-activate-tab first-id 5)
              (should-not (sumi-explorer-selected-files))
              (sumi-explorer-activate-tab second-id 5)
              (sumi-explorer-home 5)
              (should (equal (cdr (assoc "directory" (sumi-explorer-state))) home))
              (sumi-explorer-back 5)
              (should (equal (cdr (assoc "directory" (sumi-explorer-state))) second))
              (sumi-explorer-close-tab 5)
              (should (equal (cdr (assoc "active" (sumi-explorer-tabs))) first-id))
              (should-error (sumi-explorer-activate-tab second-id 5))
              (should-error (sumi-explorer-close-tab 5))
              (sumi-explorer-new-tab nil 5)
              (let ((new-id (cdr (assoc "active" (sumi-explorer-tabs)))))
                (should (> (string-to-number new-id) (string-to-number second-id))))
              (sumi-explorer-close-tab 5)))
          (sumi-explorer-stop))
      (sumi-explorer-stop t)
      (delete-directory root t))))

(ert-deftest sumi-explorer-native-emacs-presentation-bookmarks ()
  "Exercise tab presentation and isolated bookmark persistence through Emacs."
  (let* ((root (make-temp-file "sumi-native-presentation-" t))
         (default-directory (expand-file-name default-directory))
         (first (expand-file-name "first 日本語" root))
         (second (expand-file-name "second" root))
         (selected (expand-file-name "日本語;\\\n file" first))
         (hidden (expand-file-name ".hidden 日本語" first))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN") sumi-explorer--default-executable))
         (process-environment (copy-sequence process-environment))
         (sumi-explorer--session-directory nil) (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil) (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0) (sumi-explorer--quit-requested nil)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (make-directory first) (make-directory second)
          (setenv "HOME" root)
          (setenv "XDG_CONFIG_HOME" (expand-file-name "config" root))
          (setenv "XDG_DATA_HOME" (expand-file-name "data" root))
          (with-temp-file selected (insert "selected fixture\n"))
          (with-temp-file hidden (insert "hidden fixture\n"))
          (sumi-explorer-start first binary)
          (sumi-explorer-select selected)
          (sumi-explorer-sort "size" 5)
          (sumi-explorer-order "desc" 5)
          (sumi-explorer-set-view "details" 5)
          (should (equal (sumi-explorer-selected-files) (list selected)))
          (let ((view (sumi-explorer-view-settings)))
            (should (equal (cdr (assoc "sort" view)) "size"))
            (should (equal (cdr (assoc "order" view)) "desc"))
            (should (equal (cdr (assoc "view" view)) "details")))
          (sumi-explorer-filter "no matching identity" 5)
          (should-not (sumi-explorer-selected-files))
          (sumi-explorer-filter "日本語" 5)
          (let ((first-id (cdr (assoc "active" (sumi-explorer-tabs)))))
            (sumi-explorer-new-tab second 5)
            (should (equal (cdr (assoc "filter" (sumi-explorer-view-settings))) ""))
            (sumi-explorer-activate-tab first-id 5)
            (should (equal (cdr (assoc "filter" (sumi-explorer-view-settings))) "日本語"))
            (should (equal (cdr (assoc "view" (sumi-explorer-view-settings))) "details")))
          (sumi-explorer-filter "" 5)
          (sumi-explorer-show-hidden t 5)
          (sumi-explorer-select hidden)
          (sumi-explorer-show-hidden nil 5)
          (should-not (sumi-explorer-selected-files))
          (should (equal (cdr (assoc "hidden" (sumi-explorer-view-settings))) "0"))
          (sumi-explorer-bookmark-add nil 5)
          (sumi-explorer-bookmark-add second 5)
          (should (equal (cdr (assoc "bookmarks" (sumi-explorer-bookmarks))) (list first second)))
          (sumi-explorer-bookmark-remove first 5)
          (sumi-explorer-bookmark-open second 5)
          (should (equal (cdr (assoc "directory" (sumi-explorer-state))) second))
          (should-error (sumi-explorer-bookmark-open first 5))
          (sumi-explorer-stop)
          ;; A new process reloads only the isolated user-config bookmark file.
          (sumi-explorer-start first binary)
          (should (equal (cdr (assoc "bookmarks" (sumi-explorer-bookmarks))) (list second)))
          (sumi-explorer-bookmark-remove second 5)
          (should-not (cdr (assoc "bookmarks" (sumi-explorer-bookmarks))))
          (sumi-explorer-stop))
      (sumi-explorer-stop t)
      (delete-directory root t))))

(ert-deftest sumi-explorer-native-emacs-clipboard-workflow ()
  "Require actual COPY/CUT Paste completion and no-overwrite on isolated files."
  (let* ((root (make-temp-file "sumi-native-clipboard-" t))
         (default-directory (expand-file-name default-directory))
         (source-directory (expand-file-name "sources" root))
         (destination (expand-file-name "destination" root))
         (copied (expand-file-name "copied 日本語;\\\n file" source-directory))
         (moved (expand-file-name "cut 日本語 file" source-directory))
         (binary (or (getenv "SUMI_EXPLORER_TEST_BIN") sumi-explorer--default-executable))
         (process-environment (copy-sequence process-environment))
         (sumi-explorer--session-directory nil) (sumi-explorer--owned-session nil)
         (sumi-explorer--process nil) (sumi-explorer--owned-process nil)
         (sumi-explorer--request-id 0) (sumi-explorer--quit-requested nil)
         (sumi-explorer--pending nil))
    (unwind-protect
        (progn
          (make-directory source-directory) (make-directory destination)
          (setenv "HOME" root)
          (setenv "XDG_CONFIG_HOME" (expand-file-name "config" root))
          (setenv "XDG_DATA_HOME" (expand-file-name "data" root))
          (with-temp-file copied (insert "clipboard copy bytes\n"))
          (with-temp-file moved (insert "clipboard cut bytes\n"))
          (sumi-explorer-start source-directory binary)
          (sumi-explorer-select copied)
          (sumi-explorer-clipboard-copy 5)
          (sumi-explorer-open-directory destination)
          (sumi-explorer-paste nil 10)
          (should (file-exists-p copied))
          (should (equal (sumi-explorer-integration--bytes copied)
                         (sumi-explorer-integration--bytes
                          (expand-file-name (file-name-nondirectory copied) destination))))
          (sumi-explorer-open-directory source-directory)
          (sumi-explorer-select moved)
          (sumi-explorer-clipboard-cut 5)
          (sumi-explorer-paste destination 10)
          (should-not (file-exists-p moved))
          (should (equal (sumi-explorer-integration--bytes
                          (expand-file-name (file-name-nondirectory moved) destination)) "clipboard cut bytes\n"))
          (sumi-explorer-select copied)
          (sumi-explorer-clipboard-copy 5)
          (should-error (sumi-explorer-paste destination 10))
          (should (equal (sumi-explorer-integration--bytes copied) "clipboard copy bytes\n"))
          (should (equal (sumi-explorer-integration--bytes
                          (expand-file-name (file-name-nondirectory copied) destination)) "clipboard copy bytes\n"))
          (should-not sumi-explorer--pending)
          (sumi-explorer-refresh)
          (sumi-explorer-stop))
      (sumi-explorer-stop t)
      (delete-directory root t))))

(let ((selector (or (getenv "SUMI_EXPLORER_TEST_SELECTOR") "sumi-explorer-native-")))
  (unless (ert-select-tests selector t)
    (error "Native test selector matched zero tests: %s" selector))
  (ert-run-tests-batch-and-exit selector))

